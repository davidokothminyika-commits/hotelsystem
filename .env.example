# ==========================================
#  HOTEL MANAGEMENT SYSTEM - ENVIRONMENT
# ==========================================
#  Copy this file to .env and fill in real values.
#  .env is git-ignored and must never be committed.
#  Every secret below has a safe development fallback so the
#  project runs on localhost without extra setup.
# ==========================================

# ---------- Application ----------
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
APP_NAME=Aurelia Grand Hotel

# ---------- Database (MySQL / MariaDB) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=test_hotel_system
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# ---------- Authentication ----------
# Generate a strong secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-before-deploying
JWT_EXPIRES_IN=1d

# Signs the CSRF double-submit cookie.
COOKIE_SECRET=change-me-to-another-long-random-string

# ---------- Password reset tokens ----------
# Lifetime of a password reset link, in minutes.
PASSWORD_RESET_EXPIRY_MINUTES=60
# Lifetime of an email verification link, in minutes.
EMAIL_VERIFICATION_EXPIRY_MINUTES=1440

# ---------- Mail ----------
# When MAIL_ENABLED=false the mailer logs the message to the
# server console instead of sending it. This keeps password
# reset and verification links reachable during local dev.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Aurelia Grand Hotel
MAIL_FROM_ADDRESS=no-reply@example.com

# ---------- Uploads ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ---------- Security / rate limiting ----------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20