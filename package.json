{
    "name": "hotel-management-system",
    "version": "1.0.0",
    "description": "Hotel management, booking and restaurant system built with Node.js, Express, MySQL and a modular vanilla frontend.",
    "type": "module",
    "main": "src/server.js",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "nodemon src/server.js",
        "start": "node src/server.js",
        "seed": "node src/database/seed.js",
        "db:reset": "node src/database/reset.js",
        "test": "node --test tests/*.test.js",
        "test:watch": "node --test --watch tests/*.test.js"
    },
    "keywords": [
        "hotel",
        "booking",
        "restaurant",
        "express",
        "mysql"
    ],
    "license": "MIT",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.2.0",
        "express-validator": "^7.1.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^2.4.0",
        "mysql2": "^3.10.1",
        "nodemailer": "^10.0.13"
    },
    "devDependencies": {
        "nodemon": "^3.1.4"
    }
}
